# Copy to .env for local development, and set the same variables in your host's
# dashboard (Vercel: Project → Settings → Environment Variables).
# Only VITE_-prefixed variables reach the browser, so never put secret keys here.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Public origin, used for canonical URLs, Open Graph tags and printed links.
# No trailing slash. Defaults to https://agsws.org when unset.
VITE_SITE_URL="https://agsws.org"

# Prototype builds only. "true" skips Stripe so the donation journey can be
# demonstrated end to end without taking a payment, and blocks search indexing.
# MUST be absent or "false" for the real site.
VITE_DEMO_MODE="false"
